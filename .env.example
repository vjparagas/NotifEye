# Copy to `.env` and fill in. NEVER commit `.env`.

# ── Database (matches docker-compose.yml defaults) ───────────────────────────
POSTGRES_USER=notifeye
POSTGRES_PASSWORD=notifeye_dev_password
POSTGRES_DB=notifeye
DATABASE_URL=postgres://notifeye:notifeye_dev_password@localhost:5432/notifeye
TEST_DATABASE_URL=postgres://notifeye:notifeye_dev_password@localhost:5432/notifeye_test

# ── Backend ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
# Comma-separated origins allowed to call the API (dashboard dev server, extension origin in prod).
# The dashboard authenticates with an httpOnly cookie, so the API must send credentialed CORS
# for exactly these origins (never "*").
CORS_ORIGINS=http://localhost:5173
# Public URL of the dashboard (used in email links). Google sign-in is dashboard-only (professors);
# the extension uses email/password and has no hand-off to the dashboard.
DASHBOARD_URL=http://localhost:5173

# ── Google OAuth 2.0 (leave blank to disable Google sign-in) ─────────────────
GOOGLE_CLIENT_ID=

# ── Email (Nodemailer). Defaults point at Mailpit from docker-compose. ───────
# EMAIL_PROVIDER: smtp | sendgrid
EMAIL_PROVIDER=smtp
EMAIL_FROM="NotifEye <no-reply@notifeye.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# For Gmail SMTP: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_SECURE=true + an app password.
SENDGRID_API_KEY=

# ── Demo mode: shortens thresholds so the demo runs in minutes (see README, Phase 8) ──
DEMO_MODE=false

# ── Data retention ───────────────────────────────────────────────────────────
EVENT_RETENTION_DAYS=180
